{
  "id": null,
  "uid": "devplatform-metrics",
  "title": "DevPlatform Metrics",
  "tags": ["devplatform"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_errors_total[5m]) or vector(0)",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "null as zero"
        }
      }
    },
    {
      "id": 3,
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "pod_cpu_usage_millicores / 1000",
          "legendFormat": "{{pod_name}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "short", "label": "CPU (cores)" },
        { "format": "short" }
      ]
    },
    {
      "id": 4,
      "title": "Pod Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "pod_memory_usage_bytes / 1024 / 1024",
          "legendFormat": "{{pod_name}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "mbytes", "label": "Memory (MB)" },
        { "format": "short" }
      ]
    },
    {
      "id": 5,
      "title": "Request Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50 {{endpoint}}",
          "refId": "B"
        }
      ],
      "yaxes": [
        { "format": "s", "label": "Duration (seconds)" },
        { "format": "short" }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {}
}
